# Enforce the engines field in package.json: pnpm hard-fails (instead of merely warning)
# when Node/pnpm are out of range. This is what stops the version drift that broke local
# runs — e.g. the machine's global pnpm 11 (which needs Node 22+) being used against this
# project on Node 20. With pnpm pinned to 9 via package.json "packageManager", Corepack
# selects the right pnpm automatically and this makes a wrong one fail loudly.
engine-strict=true
